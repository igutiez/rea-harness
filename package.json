{
  "name": "rea-harness",
  "version": "0.1.1",
  "private": true,
  "description": "A private rsc meta-harness with REA: project memory, tested tools, skills, reflexes and artifact evidence for AI coding agents.",
  "type": "module",
  "bin": {
    "rea-harness": "scripts/rsc.js",
    "rsc": "scripts/rsc.js",
    "rsc-install": "scripts/install-apply.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "manifest": "node scripts/build-manifest.js",
    "manifest:check": "node scripts/build-manifest.js --check",
    "validate": "node scripts/build-manifest.js --validate",
    "drift:check": "node scripts/drift-check.js",
    "drift:knowledge": "node scripts/drift-check.js --knowledge",
    "knowledge:doctor": "node scripts/knowledge-doctor.js",
    "test": "node --test",
    "coverage": "c8 --reporter=text node --test",
    "check": "npm run validate && npm run manifest:check && npm test && npm run drift:check",
    "version": "npm run manifest && git add manifest.json"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "ajv": "^8.18.0"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  },
  "files": [
    "scripts",
    "targets",
    "schema",
    "skills",
    "manifest.json",
    "README.md",
    "LICENSE",
    "UPSTREAM.md",
    "THIRD_PARTY_NOTICES.md",
    "install.sh",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "deepseek-harness",
    "reverse-engineering",
    "mcp",
    "rea",
    "agent-harness",
    "skills"
  ],
  "license": "MIT",
  "author": "igutiez",
  "homepage": "https://github.com/igutiez/rea-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igutiez/rea-harness.git"
  },
  "bugs": {
    "url": "https://github.com/igutiez/rea-harness/issues"
  },
  "rscFixes": [
    {
      "fixedIn": "0.1.1",
      "symptom": "The REA proof checked registrations for clients this project never selected, so an unrelated missing client made a healthy harness look broken"
    },
    {
      "fixedIn": "0.1.0",
      "symptom": "REA registration is dropped when rsc rewrites the DeepSeek Harness Cordis patch; foreign inserts are now preserved"
    },
    {
      "fixedIn": "0.1.0",
      "symptom": "Onboarding could install the REA MCP server without the explicit --with-rea consent; it is now a plan decision"
    }
  ]
}
